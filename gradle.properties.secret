# Template of the project properties needed for this project.
# Copy this file to <User dir>/.gradle/gradle.properties and fill in the values. Some are optional.
# Do not leave sensitive info here (i.e. passwords, usernames, ip adresses, etc.)

# Maven repositories (Nexus, Artifactory, etc.)
mavenRepoUsername =
mavenRepoPassword =
mavenRepoUrl =
#Snapshot repo (put same url as release if using only one repo)
mavenSnapshotRepoUrl =

#Team Work Cloud credentials
# Used for TWC based tests. The account needs to have read, write and branch creation rights for
# the test projects.
twcUsername =
twcPassword =
ipServer =

#Maven Central (Sonatype OSSRH) credentials
mavenCentralUsername =
mavenCentralPwd =

# GPG Signing (only necessary to publish to Maven Central, is ignored for non-release versions and should only be setup
# on the CI/CD environment)
signing.gnupg.keyName =
signing.gnupg.passphrase =
signing.gnupg.executable =